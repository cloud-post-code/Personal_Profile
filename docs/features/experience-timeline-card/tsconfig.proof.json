{
  // The app's tsconfig sets "jsx": "preserve" because Next compiles the JSX.
  // This proof mounts app/cards/Cards.tsx for real, so the JSX has to actually
  // be transformed, and with the automatic runtime — the component does not
  // import React itself.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx"
  }
}
