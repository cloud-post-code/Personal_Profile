{
  // The app's tsconfig sets "jsx": "preserve" because Next compiles the JSX.
  // Running a component through react-dom/server under tsx needs it actually
  // transformed, and with the automatic runtime — otherwise the emitted
  // React.createElement calls reference a React the component never imports.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx"
  }
}
