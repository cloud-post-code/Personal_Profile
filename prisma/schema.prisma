// Prisma schema for Blake's personal site.
// Production/Railway: Postgres. This file is currently in SQLite mode for local
// dev. At push/deploy time, run `node scripts/use-postgres.mjs` to switch the
// provider to "postgresql" and re-add long-text annotations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A unit of knowledge the chatbot can cite. Created from the unified
/// "extraction" ingest: a URL, an uploaded PDF, or pasted text/markdown.
model Source {
  id        String   @id @default(cuid())
  /// link | pdf | text
  type      String   @default("link")
  /// For link sources; unique so re-adding the same URL updates it.
  url       String?  @unique
  /// Original filename for pdf/uploaded sources.
  filename  String?
  title     String?
  /// Cleaned full text extracted from the source.
  rawText   String? @db.Text
  /// Claude-generated summary used as chatbot knowledge.
  summary   String? @db.Text
  /// JSON array of tags, stored as a string.
  tags      String   @default("[]")
  /// linkedin | project | article | resume | note | other — content category.
  kind      String   @default("other")
  imageUrl  String?
  status    String   @default("pending") // pending | scanned | failed
  error     String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks    Chunk[]
}

/// A passage of a Source's raw text, embedded for retrieval. Chunks are
/// rebuilt wholesale whenever their source is (re)indexed and cascade-delete
/// with it.
model Chunk {
  id         String   @id @default(cuid())
  /// Which admin surface this chunk was derived from:
  /// source | profile | persona | project | photo | activity.
  /// Everything the admin curates feeds one index, not just Sources.
  originKind String   @default("source")
  /// Id of the origin row. The singletons use their kind as the id
  /// ("profile", "persona"); the rest use Project/Photo/ChatMessage/Source ids.
  originId   String   @default("")
  /// Human-readable label used when citing this chunk in the prompt.
  originLabel String  @default("")
  /// Set only for source-derived chunks, so they cascade with the Source.
  source     Source?  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String?
  /// 0-based position within the origin.
  seq        Int      @default(0)
  text       String @db.Text
  /// Float32Array bytes; null when embedding failed.
  embedding  Bytes?
  /// Which embedder produced `embedding`. Cosine only compares same-model
  /// vectors, so mixing providers over time degrades gracefully.
  embedModel String?
  createdAt  DateTime @default(now())
  mentions   EntityMention[]

  @@index([sourceId])
  @@index([originKind, originId])
}

/// A named thing the knowledge base talks about (person, org, project, ...).
/// `key` is the normalized lookup form (lowercased, single-spaced).
model Entity {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  /// person | org | project | skill | place | topic | event | other
  type      String   @default("topic")
  createdAt DateTime @default(now())
  mentions  EntityMention[]
  edgesOut  EntityEdge[] @relation("EdgeFrom")
  edgesIn   EntityEdge[] @relation("EdgeTo")
}

/// Which chunks mention which entities. Used to hop from retrieved text to
/// the graph and back.
model EntityMention {
  id       String @id @default(cuid())
  chunk    Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  chunkId  String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId String

  @@unique([chunkId, entityId])
  @@index([entityId])
}

/// A directed, labeled relation between two entities ("Zephyrwind —developed
/// at→ Aeolus Labs"). Powers one-hop expansion at retrieval time.
model EntityEdge {
  id       String @id @default(cuid())
  from     Entity @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  fromId   String
  to       Entity @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  toId     String
  relation String
  origins  EntityEdgeOrigin[]

  @@unique([fromId, toId, relation])
  @@index([toId])
}

/// Which origin asserted an edge. Edges are deduped across origins, so a
/// relation two surfaces both state is owned by both and only disappears when
/// the last owner is deleted or stops asserting it.
///
/// An edge with NO rows here is never auto-pruned: that covers relations added
/// by hand on the Graph tab and every edge written before provenance existed.
/// Only an edge whose ownership was recorded and then fully retracted is
/// deleted, so adding this table can't silently empty an existing graph.
model EntityEdgeOrigin {
  id         String     @id @default(cuid())
  edge       EntityEdge @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  edgeId     String
  /// Matches Chunk.originKind / Chunk.originId.
  originKind String
  originId   String

  @@unique([edgeId, originKind, originId])
  @@index([originKind, originId])
}

/// An uploaded photo. On upload we ask Claude vision for a one-paragraph
/// description; it's editable afterward. Exposed individually or in galleries.
model Photo {
  id          String   @id @default(cuid())
  /// Stored filename on the upload volume.
  filename    String
  /// One-paragraph AI (or manual) description.
  description String   @default("") @db.Text
  caption     String?
  /// gallery | project | profile
  kind        String   @default("gallery")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

/// A curated project. Each has up to two links: a GitHub repo and a live URL.
model Project {
  id          String   @id @default(cuid())
  name        String
  blurb       String @db.Text
  /// Longer AI-enriched write-up, shown when a card's "Learn more" expands.
  detail      String? @db.Text
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?
  /// JSON array of tags, stored as a string.
  tags        String   @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A single visitor conversation with the chatbot. One row per browser
/// session (the client sends a stable sessionId); messages hang off it so the
/// admin "Activity" tab can replay what people are asking.
model ChatSession {
  id         String        @id @default(cuid())
  /// Stable id generated client-side and reused across a visitor's turns.
  visitorKey String        @unique
  /// First user question — a quick label for the conversation list.
  firstQuery String        @default("") @db.Text
  messages   ChatMessage[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

/// One message inside a ChatSession: either the visitor's question or the
/// bot's answer. Text only — rendered cards aren't stored.
model ChatMessage {
  id        String      @id @default(cuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  /// user | assistant
  role      String
  content   String @db.Text
  createdAt DateTime    @default(now())

  // ── Admin feedback (set from the Activity tab, only on assistant messages) ──
  /// null = unrated, "up" = good answer, "down" = bad answer.
  rating    String?
  /// Blake's correction: what the bot should have done instead. When set on a
  /// "down"-rated message, it's injected into future system prompts as guidance.
  note      String? @db.Text

  @@index([sessionId])
}

/// A hand-written answer to a question visitors ask over and over — the
/// starter chips, mostly. When an incoming message normalizes to `matchKey`,
/// the chatbot serves `answer` directly and never calls the model. Written and
/// edited on the admin "Answers" tab; a blank `answer` is a to-do, not a
/// response, so the question falls through to the model until it's filled in.
model CannedAnswer {
  id        String   @id @default(cuid())
  /// The question as written, shown in the admin list.
  question  String @db.Text
  /// `question` run through normalizeQuestion() — the actual lookup key.
  matchKey  String   @unique
  /// The answer text. Empty means "not written yet": falls through to the model.
  answer    String   @default("") @db.Text
  /// True while `answer` is a model-written draft Blake hasn't reviewed. A
  /// draft is served exactly like a hand-written answer — it comes from the
  /// same retrieval + persona prompt the chatbot would have used — so this is
  /// an admin-facing distinction only: it drives the "unreviewed" marker and is
  /// cleared the moment Blake saves the row.
  aiDraft   Boolean  @default(false)
  /// When a draft was last generated for this row. Non-null means the automatic
  /// pass has already spent its one shot here and must never fire again — so a
  /// row Blake deliberately empties stays empty instead of refilling itself.
  draftedAt DateTime?
  /// Optional card to render alongside the answer, named by the tool that
  /// would have drawn it: show_projects | show_project | show_gallery |
  /// show_contact_form. Hydrated through the same path the model path uses.
  cardTool  String?
  /// JSON args for `cardTool`, e.g. {"id":"..."} or {"layout":"filmstrip"}.
  cardInput String?
  /// Off without losing the text.
  enabled   Boolean  @default(true)
  /// Times served — the running count of model calls this row has avoided.
  hits      Int      @default(0)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A contact submission captured by the in-chat A2UI contact form.
model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// The single editable profile: identity, bio, persona, brand/theme, contact.
/// Everything the chatbot knows about Blake plus what drives the site's look.
model Profile {
  id        Int      @id @default(1)

  // ── Details ──
  name      String   @default("Blake")
  location  String   @default("")
  /// JSON array of {label, url} social links.
  socials   String   @default("[]")
  email     String   @default("")
  linkedin  String   @default("")
  github    String   @default("")

  // ── Bio (fillable via file upload: CSV / text) ──
  bio       String   @default("") @db.Text
  /// JSON array of {role, company, dates, description} experience entries.
  experience String  @default("[]") @db.Text
  /// Prose paragraph summarizing work experience, shown on the profile.
  experienceSummary String @default("") @db.Text
  /// Free-text "everything else" from the resume: education, skills, awards.
  other      String  @default("") @db.Text

  // ── Persona & brand ──
  tagline   String   @default("")
  /// JSON {sectionKey: text} for the persona + agent-behavior sections
  /// catalogued in lib/persona.ts. This is the persona the chatbot speaks from.
  personaSections String @default("{}") @db.Text
  /// Free-text description of the visual feeling — edited on the Theme tab.
  aesthetic String   @default("") @db.Text
  headshot  String?  // /api/uploads/<file>

  // ── Retired persona fields ──
  // Superseded by personaSections; kept so existing text survives until it can
  // be mapped into sections. Nothing reads these.
  persona   String   @default("") @db.Text
  overview  String   @default("") @db.Text
  values    String   @default("") @db.Text
  tone      String   @default("") @db.Text

  // ── Theme (drives the live site's CSS variables) ──
  /// Curated heading font key (see lib/fonts).
  themeFont String   @default("space-grotesk")
  /// Curated body/text font key (see lib/fonts).
  themeBodyFont String @default("inter")
  /// JSON {bg, surface, border, text, textMuted, primary, accent} hex overrides.
  themeColors String @default("{}")
  /// Corner roundness preset: sharp | rounded | pill.
  themeRadius String @default("rounded")
  /// Base font size in px (body text scale). Empty = default 16.
  themeFontSize String @default("")
  /// Heading font weight: 500 | 600 | 700 | 800. Empty = default.
  themeHeadingWeight String @default("")

  // ── Booking (the in-chat booking card, backed by Google Calendar) ──
  /// Master switch. Off until Google is connected, so a half-configured deploy
  /// never shows a visitor a booker that cannot book.
  bookingEnabled   Boolean @default(false)
  /// IANA zone the weekly hours below are expressed in, and the zone the
  /// calendar event is written with. Wall-clock hours are meaningless without it.
  bookingTz        String  @default("America/New_York")
  /// Meeting length in minutes; also the step of the slot grid.
  bookingMinutes   Int     @default(30)
  /// JSON {mon:[["09:00","17:00"]], tue:[...], ...} weekly availability windows.
  /// Absent or empty day = not available that day.
  bookingHours     String  @default("{}") @db.Text
  /// Hours of notice before the earliest bookable slot.
  bookingLeadHours Int     @default(12)
  /// How many days ahead the card offers.
  bookingDays      Int     @default(14)
  /// Gap enforced on both sides of an existing calendar event, in minutes.
  bookingBufferMinutes Int @default(15)
  /// Shown as the calendar event's title, with the guest's name appended.
  bookingTitle     String  @default("Intro call")

  // ── Google Calendar connection (granted from the Booking tab) ──
  /// The OAuth refresh token, ENCRYPTED with AUTH_SECRET — never the raw token.
  /// See lib/googleConnection.ts. Empty until Blake connects; GOOGLE_REFRESH_TOKEN
  /// in the environment still takes precedence when it is set.
  googleRefreshToken String @default("") @db.Text
  /// When the grant was made, so the tab can say how old the connection is.
  /// Google expires refresh tokens for consent screens left in "Testing".
  googleConnectedAt  DateTime?

  updatedAt DateTime @updatedAt
}

/// A meeting a visitor booked through the in-chat booking card. This is Blake's
/// own record: the authoritative event lives in Google Calendar, and whatever
/// later happens to it there (edited, moved, deleted) does not reach back here.
///
/// `startsAt` is unique on purpose. Between reading free/busy and writing the
/// event there is a window where two visitors can pick the same slot; the row is
/// claimed before the Google call, so the constraint — not a hopeful re-check —
/// is what makes the loser lose. Cancelling is done in Google Calendar, and the
/// row is deleted from the admin, which is also what frees the slot again.
model Booking {
  id            String   @id @default(cuid())
  name          String
  email         String
  note          String   @default("") @db.Text
  /// Slot bounds as instants (UTC).
  startsAt      DateTime @unique
  endsAt        DateTime
  /// IANA zone the visitor saw the slot in, so the admin can read their local
  /// time back without guessing where they were.
  guestTz       String   @default("")
  /// Google Calendar event id — the trace from this row to the real event.
  googleEventId String?
  /// Google Meet link, when Google issued one.
  meetUrl       String?
  createdAt     DateTime @default(now())

  @@index([startsAt])
}

/// One A2A task: work another agent asked this agent to do over the A2A
/// endpoint (lib/a2a). Persisted rather than held in memory because the
/// protocol lets a caller send a message now and fetch the result later —
/// GetTask/ListTasks/CancelTask have to survive the request that created the
/// task, and on Railway they also have to survive a redeploy.
model A2ATask {
  id        String   @id
  /// Groups tasks into one conversation. Reused as the chat sessionId, so an
  /// agent-to-agent conversation shows up in Activity like any visitor's.
  contextId String
  /// TaskState in short form: submitted | working | completed | failed |
  /// canceled | rejected. Rendered to the wire spelling per protocol version.
  state     String   @default("submitted")
  /// JSON array of A2A Message objects (v1.0 shape) — the turn history.
  history   String   @default("[]") @db.Text
  /// JSON array of A2A Artifact objects (v1.0 shape) — the answer and any
  /// UI cards the brain emitted, as structured data parts.
  artifacts String   @default("[]") @db.Text
  /// Human-readable reason the task ended in `failed`.
  error     String?  @db.Text
  /// Set by CancelTask. The runner checks it between brain events, which is
  /// the only safe place to stop — mid-stream there is nothing to roll back.
  cancelRequested Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contextId])
  @@index([state])
  @@index([createdAt])
}
