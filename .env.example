# ---- Copy to .env and fill in ----

# Postgres connection string.
# Local dev: you can use SQLite instead (see prisma/schema.prisma comment),
# but for Railway parity, run Postgres. Railway injects DATABASE_URL automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/blake?schema=public"

# Anthropic Claude API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Which Claude model the chatbot + link summarizer use.
CLAUDE_MODEL="claude-haiku-4-5-20251001"

# Password for the /admin portal (simple gate — change this!).
ADMIN_PASSWORD="change-me-please"

# Secret used to sign the admin session cookie. Use a long random string.
AUTH_SECRET="generate-a-long-random-string-here"

# Where uploaded images are written.
# Local: ./data/uploads   |   Railway: mount a volume at /data and set UPLOAD_DIR=/data/uploads
UPLOAD_DIR="./data/uploads"

# Public base URL of the site (used for absolute links). Optional in dev.
# IMPORTANT for A2A: this is the URL the Agent Card advertises to other agents.
# If it's wrong, they'll be told to call an address that doesn't answer. When
# unset, the card falls back to the incoming request's host.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- A2A (agent-to-agent interface) ----
# The A2A endpoint is CLOSED. Every call must send
# `Authorization: Bearer <token>`, matching either this key or ADMIN_PASSWORD.
# Prefer setting a dedicated key: anyone you give the admin password to for
# agent access also gets your admin portal. Leave it blank and the admin
# password is the only credential. If NEITHER is set, the endpoint refuses
# everyone rather than falling open.
A2A_API_KEY=""

# Requests allowed per caller IP per minute. Every accepted call spends model
# credits, so this is on by default. 0 disables the limit.
A2A_RATE_LIMIT="30"

# ---- Google Calendar (the in-chat booking card) ----
# Leave these blank and the booking card stays off — the model isn't even told
# the tool exists, so nothing breaks; visitors just get the contact form.
#
# Setup, once:
#   1. console.cloud.google.com -> new project -> enable the Google Calendar API
#   2. OAuth consent screen: External, add yourself as a test user, then PUBLISH
#      it (unverified is fine for one user). While it's in "Testing", Google
#      expires refresh tokens after 7 days and the card will silently go quiet.
#   3. Credentials -> OAuth client ID -> Web application, redirect URI
#      http://localhost:5858/callback
#   4. Fill in the two values below, then run:  node scripts/google-auth.mjs
#      and paste the refresh token it prints.
#
# Scopes requested are calendar.freebusy + calendar.events only: the site can
# see WHEN you're busy and add events, but cannot read your meetings.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# Which calendar to read and write. "primary" is the account's main calendar.
GOOGLE_CALENDAR_ID="primary"
# Bookings allowed per caller IP per hour. Each one writes a real event and
# emails a real invite, so this is on by default. 0 disables the limit.
BOOKING_RATE_LIMIT="5"

# PostHog client analytics. Both are public (NEXT_PUBLIC_) — the project API
# key is safe to ship in the browser. Get it from PostHog → Project Settings.
# Leave the key blank to disable analytics (the provider no-ops).
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Model for the admin card builder only (falls back to CLAUDE_MODEL when unset)
CARD_BUILDER_MODEL="claude-sonnet-5"

# ---- Card builder images ----
# The builder can put real artwork in a card two ways. Finding an image the
# owner already has (uploaded photos, project images, headshot) always works
# and needs no key. Generating NEW artwork needs OPENAI_API_KEY — the same key
# the embedding fallback uses. Leave it blank and the generate tool is simply
# never offered to the model; cards fall back to found images or a flat swatch.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"
